# Supabase
# Supabase renamed its keys: `anon` → "publishable" (sb_publishable_*),
# `service_role` → "secret" (sb_secret_*). The values are interchangeable;
# we keep the env var names below because the SDKs still read them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # paste sb_publishable_* here
SUPABASE_SERVICE_ROLE_KEY=              # paste sb_secret_* here (server-only)

# Anthropic
ANTHROPIC_API_KEY=

# PostHog (demo project)
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_ID=

# GitHub App (demo)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_DEMO_REPO=JoaquinGiorgis/helix-demo-saas

# Backend
HELIX_API_URL=http://localhost:8000
HELIX_API_INTERNAL_TOKEN=

# Demo mode
HELIX_DEMO_MODE=true
HELIX_FAST_FORWARD_ENABLED=true
